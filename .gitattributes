# Auto detect text files and perform LF normalization
* text=auto

# Web assets are served verbatim; force LF on checkout so the inline-script CSP
# hash (D-20) stays byte-stable across platforms — a CRLF checkout would change
# the script bytes and break the policy.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary assets
*.png binary
*.ico binary
*.webp binary
