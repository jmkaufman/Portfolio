{
  // Launches Chrome against the VS Code Live Server preview (D-33).
  // Live Server's default origin is http://127.0.0.1:5500.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against Live Server",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
